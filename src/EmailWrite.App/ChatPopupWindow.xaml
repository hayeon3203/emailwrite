<Window x:Class="EmailWrite.App.ChatPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmailWrite.App"
        Title="EmailWrite Chat"
        Width="320" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="FlatIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF5B8DEF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="#FFFAFAFC" BorderBrush="#20000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Avatar/daol-avatar-face.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <TextBlock Grid.Column="1" Text="EmailWrite" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FF2A2A2A" VerticalAlignment="Center" Margin="8,0,0,0" />

                    <Button Grid.Column="2" x:Name="CloseButton" Content="&#x2715;" Width="22" Height="22"
                            Style="{StaticResource FlatIconButtonStyle}" Foreground="#FF8A8A8A"
                            Click="CloseButton_Click" />
                </Grid>
            </Grid>

            <!-- Messages -->
            <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="8,4">
                <StackPanel>
                    <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ChatMessageViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="4,4">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Avatar sits ahead of the bubble: the assistant is on the left now. -->
                                    <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,6,0"
                                            VerticalAlignment="Bottom">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Avatar/daol-avatar-face.png"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <Border CornerRadius="14" Padding="10,8" MaxWidth="210">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFEFEFF3" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                        <Setter Property="Background" Value="#FF5B8DEF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF2A2A2A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="복사" Click="CopyMessage_Click" Tag="{Binding Text}"
                                                    FontSize="10" Padding="4,1" Margin="0,4,0,-2"
                                                    HorizontalAlignment="Right">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FlatIconButtonStyle}">
                                                        <Setter Property="Foreground" Value="#FF6A6A6A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFE8EEFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="TypingIndicator" Text="입력 중…" FontSize="11" FontStyle="Italic"
                               Foreground="#FF9A9A9A" Margin="10,2,0,4" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="2" Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="16" Background="#FFF0F0F3">
                    <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                             Padding="12,8" FontSize="13" VerticalContentAlignment="Center"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             KeyDown="InputBox_KeyDown" />
                </Border>

                <Button Grid.Column="1" x:Name="SendButton" Content="&#x27A4;" Width="34" Height="34"
                        Margin="6,0,0,0" Style="{StaticResource RoundAccentButtonStyle}"
                        Click="SendButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
