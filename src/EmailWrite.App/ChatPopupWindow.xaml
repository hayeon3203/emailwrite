<Window x:Class="EmailWrite.App.ChatPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmailWrite.App"
        Title="EmailWrite Chat"
        Width="320" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="FlatIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF5B8DEF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="#FFFAFAFC" BorderBrush="#20000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Avatar/daol-avatar-face.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <TextBlock Grid.Column="1" Text="EmailWrite" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FF2A2A2A" VerticalAlignment="Center" Margin="8,0,0,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Which model writes the draft. Kept in the header rather than in
                             settings because it is a per-mail decision, not a preference: the
                             local 2.3B is scoped to greetings, requests and promises, and a
                             draft that has to carry literals (dates, figures, names) is what
                             the API backend is for. Switching mid-conversation is the point —
                             a bad local draft plus "다시" on the API model is the repair. -->
                        <ComboBox x:Name="BackendCombo" Width="92" Height="20" FontSize="10"
                                  Margin="0,0,6,0" Padding="4,0" VerticalContentAlignment="Center"
                                  BorderThickness="0" Background="Transparent" Foreground="#FF6A6A6A"
                                  ToolTip="초안을 쓸 모델. 로컬은 PC 밖으로 아무것도 안 나가고, API는 메일 본문이 외부로 전송됩니다."
                                  SelectionChanged="BackendCombo_SelectionChanged">
                            <ComboBoxItem Tag="local" Content="로컬 (Mi:dm)" />
                            <ComboBoxItem Tag="solar" Content="Solar" />
                            <ComboBoxItem Tag="claude" Content="Claude" />
                        </ComboBox>
                        <Button x:Name="RestartButton" Content="&#x21BB;" Width="22" Height="22"
                                Style="{StaticResource FlatIconButtonStyle}" Foreground="#FF8A8A8A"
                                ToolTip="새로 시작 (대화 지우고 Outlook 다시 읽기)" Click="RestartButton_Click" />
                        <Button x:Name="HideButton" Content="&#x2014;" Width="22" Height="22"
                                Style="{StaticResource FlatIconButtonStyle}" Foreground="#FF8A8A8A"
                                ToolTip="숨기기 (대화 유지)" Click="HideButton_Click" />
                        <Button x:Name="CloseButton" Content="&#x2715;" Width="22" Height="22"
                                Style="{StaticResource FlatIconButtonStyle}" Foreground="#FF8A8A8A"
                                ToolTip="닫기 (대화 지우고 종료)" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Messages -->
            <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="8,4">
                <StackPanel>
                    <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ChatMessageViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="4,4">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Avatar sits ahead of the bubble: the assistant is on the left now. -->
                                    <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,6,0"
                                            VerticalAlignment="Bottom">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Avatar/daol-avatar-face.png"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <Border CornerRadius="14" Padding="10,8" MaxWidth="210">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFEFEFF3" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                        <Setter Property="Background" Value="#FF5B8DEF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF2A2A2A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Margin="0,4,0,-2">
                                                <!-- Rerolling the same points is the common repair:
                                                     a quarter of drafts come back unusable and the
                                                     content that produced them was fine. -->
                                                <Button Content="다시" Click="RegenerateMessage_Click" Tag="{Binding}"
                                                        FontSize="10" Padding="4,1" Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource FlatIconButtonStyle}">
                                                            <Setter Property="Foreground" Value="#FFE8EEFF" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRegenerate}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="복사" Click="CopyMessage_Click" Tag="{Binding Text}"
                                                        FontSize="10" Padding="4,1">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource FlatIconButtonStyle}">
                                                            <Setter Property="Foreground" Value="#FF6A6A6A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFE8EEFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="TypingIndicator" Text="입력 중…" FontSize="11" FontStyle="Italic"
                               TextWrapping="Wrap"
                               Foreground="#FF9A9A9A" Margin="10,2,10,4" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="2" Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="16" Background="#FFF0F0F3">
                    <Grid>
                        <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                                 Padding="12,8" FontSize="13" VerticalContentAlignment="Center"
                                 TextWrapping="Wrap" AcceptsReturn="False"
                                 KeyDown="InputBox_KeyDown" />

                        <!-- An empty box gave no clue what belongs in it, and "메신저 답장 써줘"
                             is the natural thing to type at a chat prompt. That is a request, not
                             content: with nothing to draft from, the model answers *about*
                             drafting ("네, 작성 방법 알려드릴게요"), and that reply then sits in
                             the conversation and turns every later turn into a refusal. The
                             example is the cheapest place to stop it — the model cannot be told
                             to ask for the content instead, which is what M12 already tried
                             twice. Sits on top of the box and lets clicks through to it. -->
                        <TextBlock x:Name="InputHint" Text="예: 내일까지 검토해서 드린다고" IsHitTestVisible="False"
                                   Foreground="#FFA8A8AD" FontSize="13"
                                   Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Button Grid.Column="1" x:Name="SendButton" Content="&#x27A4;" Width="34" Height="34"
                        Margin="6,0,0,0" Style="{StaticResource RoundAccentButtonStyle}"
                        Click="SendButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
